# Strata NVFP4, four-GPU lane — environment reference (.env.example)
#
# The engine reads these from the process environment. serve/server.py merges the config's
# "env" block into the engine's env, so the shipping lane carries its env INSIDE
# configs/nvfp4-512k-np2-vision.json — this file documents that block, plus the knobs worth
# knowing when reproducing or tuning the four-GPU numbers. Unset = the default in each comment.
# Every effect quoted was measured on the reference box (4x RTX 5060 Ti 16 GB on CPU-direct
# PCIe gen5 x8/x4/x8/x4, 9950X Zen5 with AVX-512, 128 GB DDR5-5000, driver 615.71.09-p2p,
# CUDA 13.3). Your box will differ; the comments say which part each variable buys.

# ================= what the shipping lane sets =================

# Card numbering by PCIe bus order. Without it CUDA may number cards "fastest first", which
# silently renumbers --peer-devices and the whole tier layout between boots. server.py sets it
# too; keeping it in the env block makes hand-started engines match.
CUDA_DEVICE_ORDER=PCI_BUS_ID

# The prompt path's expert rows the CPU computes beside the GPUs, per layer chunk.
# auto = measure each layer's CPU-vs-GPU cost and pick the share (it backs off on CPUs where
# the copies cost more than they save — a Zen3 without AVX-512 gets little or none). A fraction
# 0..1 pins the share; 0 = GPU-only. Measured on the reference box: +44% prefill at a fixed
# 6144-token chunk (the AVX-512 path runs 2.8x the ggml CPU kernels); the lane's long-prompt
# prefill 1,557 -> 1,740-1,830 t/s includes it.
STRATA_PREFILL_CPU_SHARE=auto

# Ceiling on the chunk size (tokens) the CPU share applies to. Chunks above it stay GPU-only:
# the share pays on turn-tail chunks, not on the biggest prefill bursts. 6145 = on for the
# shipping 6144-token chunks, off above them.
STRATA_PREFILL_CPU_SHARE_MAX=6145

# ================= knobs worth knowing (all optional) =================

# Peer-to-peer DMA between the cards. The patched consumer driver (README, "the p2p patch")
# enables it; without P2P every peer exchange stages through mapped host memory, so each row
# crosses its PCIe link twice. =1 forces the no-P2P fallback — the A/B switch for measuring
# what the patch buys on YOUR box before you patch anything.
#STRATA_PEER_NO_P2P=0

# Interleaved multi-column MMVQ for the head and expert projections (default on where the
# shape supports it; bitwise the plain kernels' output, so results do not change). =0 keeps
# the plain multi-column kernels.
#STRATA_MMVQ_IL=1

# Hyper-connection read variant: =1 or =0 picks the staged or the earlier per-token read; both
# are checked bit for bit against each other at boot on this card. Leave unset unless you are
# bisecting a numerics question.
#STRATA_HC_SPLIT=

# Batched decode expert gathers (default on). =0 = the per-row gather path.
#STRATA_DEC_BATCH=1

# T==1 verify windows commit their pick inside the window graph (default on; saves a commit
# launch per one-token window). =0 routes every commit through the host path. The parity-
# control switch for head-split A/Bs; the split disables self-commit itself, in code.
#STRATA_ONE_TOKEN_COMMIT=1

# Set to any value: force synchronous verify commits (disables the async commit overlap).
# Debug only — costs a stream sync per commit.
#STRATA_COMMIT_SYNC=

# Head-split correctness harness. After EVERY verify window it recomputes the full output head
# on the main GPU and compares: =1 the merged picks, =2 also the assembled logits, bitwise.
# Prints "split verify: N rows checked, no mismatch" heartbeats, and any
# "SPLIT MISMATCH" / "SPLIT LOGITS MISMATCH" line names the window and row. Costs a full head
# read per window: bench with it OFF, verify with it ON. The engine is NOT deterministic across
# boots (same config twice can diverge by one near-tie token), so this in-boot harness is the
# only valid exactness gate on this engine — never trust cross-boot byte compares.
#STRATA_DBG_SPLIT_VERIFY=

# Window-level diagnostics, both to stderr: STRATA_VERIFY_TRACE=1 = the per-window host/GPU
# handshake breadcrumbs (#649); STRATA_VERIFY_PROFILE=1 = GPU stage stamps per window.
#STRATA_VERIFY_TRACE=
#STRATA_VERIFY_PROFILE=

# Non-finite scan of the head logits: STRATA_DBG_NAN_VERIFY=1 the verify windows,
# STRATA_DBG_NAN=1 the prompt path too. Debug only.
#STRATA_DBG_NAN_VERIFY=
#STRATA_DBG_NAN=

# server.py: one log line per request (prompt tokens reused/read, generated tokens, t/s) —
# the lines the README's numbers are quoted from.
#STRATA_REQUEST_LINES=1

# server.py: =0 forces solo (non-batched) verify windows under --parallel. Leave unset to keep
# the batched windows (they amortize the trunk and the head read across slots).
#STRATA_PARALLEL_SOLO=
